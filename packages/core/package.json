{
  "name": "@traits-dev/core",
  "version": "0.7.4",
  "description": "Core traits.dev SDK for voice profile validation, behavioral policy compilation, and evaluation.",
  "keywords": [
    "traits-dev",
    "llm",
    "voice-profile",
    "behavioral-policy",
    "prompt-engineering",
    "evaluation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/justinhambleton/traits.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/justinhambleton/traits#readme",
  "author": {
    "name": "Justin Hambleton",
    "url": "https://github.com/justinhambleton"
  },
  "contributors": [
    {
      "name": "Justin Hambleton",
      "url": "https://github.com/justinhambleton"
    }
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js",
      "require": "./dist/internal.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "tsup && node --test"
  },
  "dependencies": {
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
