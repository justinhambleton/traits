{
  "name": "traits-dev",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.29.1",
  "scripts": {
    "build": "pnpm --filter @traits-dev/core build",
    "typecheck": "pnpm --filter @traits-dev/core exec tsc --noEmit",
